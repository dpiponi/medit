    },
    {
      "name": "tmux",
      "patterns": ["*.tmux", ".tmux.conf"],
      "grammar_path": "grammars/libtree-sitter-tmux.so",
      "symbol_name": "tree_sitter_tmux",
      "highlights_path": "queries/tmux/highlights.scm"
