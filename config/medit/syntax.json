    {
      "name": "haskell",
      "patterns": ["*.hs", "*.lhs"],
      "grammar_path": "grammars/libtree-sitter-haskell.so",
      "symbol_name": "tree_sitter_haskell",
      "highlights_path": "queries/haskell/highlights.scm"
    },
    {
      "name": "toml",
      "patterns": ["*.toml"],
      "grammar_path": "grammars/libtree-sitter-toml.so",
      "symbol_name": "tree_sitter_toml",
