{
  "servers": [
    {
      "name": "cpp",
      "command": "clangd --background-index",
      "language_id": "cpp",
      "extensions": [".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx"]
    },
    {
      "name": "json",
      "command": "vscode-json-languageserver --stdio",
      "language_id": "json",
      "extensions": [".json", ".jsonc"]
    },
    {
      "name": "python",
      "command": "pyright-langserver --stdio",
      "language_id": "python",
      "extensions": [".py", ".pyi", ".pyw"]
    }
  ]
}
